// Sugg Admission Management Platform - Prisma Schema
// PostgreSQL (Supabase) + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SUGG_COUNSELOR
  COLLEGE_ADMIN
  AGENCY_ADMIN
  AGENCY_COUNSELOR
}

enum CollegeStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  COUNSELING_SCHEDULED
  COLLEGE_SHORTLISTED
  APPLICATION_SUBMITTED
  OFFER_RECEIVED
  ADMISSION_CONFIRMED
  LOST
}

enum LeadSource {
  WHATSAPP
  AGENCY_REFERRAL
  MANUAL_ENTRY
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  ENROLLED
}

enum CommissionType {
  FIXED
  PERCENTAGE
  SLAB
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum NotificationType {
  NEW_LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
  FOLLOW_UP_REMINDER
  NEW_APPLICATION
  APPLICATION_STATUS_CHANGED
  COMMISSION_APPROVED
  COMMISSION_PAID
  COLLEGE_APPROVED
  NEW_REFERRAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CallType {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  ANSWERED
  MISSED
  VOICEMAIL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum DegreeType {
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
  CERTIFICATE
  OTHER
}

enum AssignmentRule {
  ROUND_ROBIN
  COURSE_BASED
  MANUAL
}

// ─── IDENTITY & AUTH ─────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  supabaseId       String    @unique @map("supabase_id")
  email            String    @unique
  phone            String?   @unique
  fullName         String    @map("full_name")
  avatarUrl        String?   @map("avatar_url")
  role             UserRole
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  college          College?  @relation("CollegeAdmin")
  agency           Agency?   @relation("AgencyAdmin")
  agencyUser       AgencyUser?
  counselor        Counselor?

  assignedLeads    Lead[]    @relation("AssignedCounselor")
  leadNotes        LeadNote[]
  leadFollowups    LeadFollowup[]
  sentMessages     WhatsappMessage[] @relation("MessageSender")
  calls            Call[]
  tasks            Task[]    @relation("TaskCreator")
  assignedTasks    Task[]    @relation("TaskAssignee")
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  roleId      String   @map("role_id")
  resource    String   // e.g. "leads", "colleges", "commissions"
  action      String   // e.g. "create", "read", "update", "delete"
  createdAt   DateTime @default(now()) @map("created_at")

  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── STUDENTS & LEADS ────────────────────────────────────────────────────────

model Student {
  id                String     @id @default(cuid())
  name              String
  mobile            String     @unique
  email             String?
  city              String?
  country           String?
  educationLevel    String?    @map("education_level")
  qualification     String?
  interestedCourse  String?    @map("interested_course")
  preferredCollege  String?    @map("preferred_college")
  preferredCountry  String?    @map("preferred_country")
  budget            Decimal?   @db.Decimal(12, 2)
  source            LeadSource @default(WHATSAPP)
  whatsappId        String?    @unique @map("whatsapp_id")
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relations
  lead              Lead?
  applications      Application[]
  whatsappMessages  WhatsappMessage[]
  referral          StudentReferral?

  @@map("students")
}

model Lead {
  id                String     @id @default(cuid())
  studentId         String     @unique @map("student_id")
  source            LeadSource @default(WHATSAPP)
  status            LeadStatus @default(NEW)
  score             Int        @default(0)
  assignedToId      String?    @map("assigned_to_id")
  assignmentRule    AssignmentRule? @map("assignment_rule")
  lastContactedAt   DateTime?  @map("last_contacted_at")
  nextFollowUpAt    DateTime?  @map("next_follow_up_at")
  lostReason        String?    @map("lost_reason")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relations
  student           Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedTo        User?      @relation("AssignedCounselor", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes             LeadNote[]
  followups         LeadFollowup[]

  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

model LeadFollowup {
  id          String     @id @default(cuid())
  leadId      String     @map("lead_id")
  userId      String     @map("user_id")
  title       String
  description String?
  dueAt       DateTime   @map("due_at")
  status      TaskStatus @default(PENDING)
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lead_followups")
}

// ─── COUNSELORS ──────────────────────────────────────────────────────────────

model Counselor {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  specializations String[] // course types they specialize in
  maxLeads        Int      @default(50) @map("max_leads")
  isAvailable     Boolean  @default(true) @map("is_available")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("counselors")
}

// ─── COMMUNICATION ───────────────────────────────────────────────────────────

model WhatsappMessage {
  id             String           @id @default(cuid())
  studentId      String           @map("student_id")
  senderId       String?          @map("sender_id")
  direction      MessageDirection
  messageId      String?          @unique @map("message_id") // Meta message ID
  type           String           @default("text") // text, image, document, audio
  content        String?
  mediaUrl       String?          @map("media_url")
  mediaType      String?          @map("media_type")
  status         MessageStatus    @default(SENT)
  sentAt         DateTime?        @map("sent_at")
  deliveredAt    DateTime?        @map("delivered_at")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sender         User?            @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@map("whatsapp_messages")
}

model Call {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  studentId   String?    @map("student_id")
  type        CallType
  status      CallStatus
  phoneNumber String     @map("phone_number")
  duration    Int?       // seconds
  notes       String?
  recordingUrl String?   @map("recording_url")
  startedAt   DateTime?  @map("started_at")
  endedAt     DateTime?  @map("ended_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calls")
}

model Task {
  id          String     @id @default(cuid())
  creatorId   String     @map("creator_id")
  assigneeId  String?    @map("assignee_id")
  title       String
  description String?
  dueAt       DateTime?  @map("due_at")
  status      TaskStatus @default(PENDING)
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  resourceId String?          @map("resource_id")
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── COLLEGES ────────────────────────────────────────────────────────────────

model College {
  id               String        @id @default(cuid())
  adminId          String?       @unique @map("admin_id")
  name             String
  slug             String        @unique
  website          String?
  officialEmail    String        @unique @map("official_email")
  contactPhone     String?       @map("contact_phone")
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  logoUrl          String?       @map("logo_url")
  description      String?
  status           CollegeStatus @default(PENDING)
  isVerified       Boolean       @default(false) @map("is_verified")
  establishedYear  Int?          @map("established_year")
  accreditation    String[]
  approvedAt       DateTime?     @map("approved_at")
  rejectionReason  String?       @map("rejection_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  admin            User?         @relation("CollegeAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  courses          Course[]
  applications     Application[]
  galleries        Gallery[]
  documents        Document[]
  socialLinks      SocialLink[]
  googleReviews    GoogleReview[]
  scholarships     Scholarship[]
  hostels          Hostel[]
  commissions      CommissionTransaction[]

  @@map("colleges")
}

model Course {
  id              String     @id @default(cuid())
  collegeId       String     @map("college_id")
  name            String
  degreeType      DegreeType
  duration        String     // e.g. "3 years", "2 semesters"
  durationMonths  Int?       @map("duration_months")
  eligibility     String?
  totalSeats      Int?       @map("total_seats")
  availableSeats  Int?       @map("available_seats")
  annualFee       Decimal?   @db.Decimal(12, 2) @map("annual_fee")
  semesterFee     Decimal?   @db.Decimal(12, 2) @map("semester_fee")
  totalFee        Decimal?   @db.Decimal(12, 2) @map("total_fee")
  description     String?
  syllabus        String?
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // Relations
  college         College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  applications    Application[]
  scholarships    Scholarship[]

  @@map("courses")
}

model Gallery {
  id          String   @id @default(cuid())
  collegeId   String   @map("college_id")
  url         String
  caption     String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("galleries")
}

model Document {
  id          String   @id @default(cuid())
  collegeId   String   @map("college_id")
  name        String
  url         String
  type        String   // "brochure", "accreditation", "affiliation", etc.
  createdAt   DateTime @default(now()) @map("created_at")

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model SocialLink {
  id         String   @id @default(cuid())
  collegeId  String   @map("college_id")
  platform   String   // "facebook", "instagram", "linkedin", "twitter", "youtube"
  url        String
  createdAt  DateTime @default(now()) @map("created_at")

  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("social_links")
}

model GoogleReview {
  id          String   @id @default(cuid())
  collegeId   String   @map("college_id")
  reviewerName String  @map("reviewer_name")
  rating      Int      // 1-5
  comment     String?
  reviewDate  DateTime @map("review_date")
  sourceUrl   String?  @map("source_url")
  createdAt   DateTime @default(now()) @map("created_at")

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("google_reviews")
}

model Scholarship {
  id          String   @id @default(cuid())
  collegeId   String   @map("college_id")
  courseId    String?  @map("course_id")
  name        String
  description String?
  amount      Decimal? @db.Decimal(12, 2)
  percentage  Decimal? @db.Decimal(5, 2)
  eligibility String?
  deadline    DateTime?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("scholarships")
}

model Hostel {
  id            String   @id @default(cuid())
  collegeId     String   @map("college_id")
  type          String   // "boys", "girls", "co-ed"
  totalRooms    Int?     @map("total_rooms")
  monthlyRent   Decimal? @db.Decimal(10, 2) @map("monthly_rent")
  annualRent    Decimal? @db.Decimal(10, 2) @map("annual_rent")
  amenities     String[]
  description   String?
  isAvailable   Boolean  @default(true) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at")

  college       College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("hostels")
}

// ─── APPLICATIONS ────────────────────────────────────────────────────────────

model Application {
  id                String            @id @default(cuid())
  studentId         String            @map("student_id")
  collegeId         String            @map("college_id")
  courseId          String            @map("course_id")
  status            ApplicationStatus @default(SUBMITTED)
  submittedById     String?           @map("submitted_by_id") // counselor who submitted
  managedBy         String            @default("SUGG") @map("managed_by") // "SUGG" | "COLLEGE"
  applicationFee    Decimal?          @db.Decimal(10, 2) @map("application_fee")
  documents         Json?             // uploaded doc URLs
  notes             String?
  acceptanceDeadline DateTime?        @map("acceptance_deadline")
  enrolledAt        DateTime?         @map("enrolled_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  college           College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  statusHistory     ApplicationStatusHistory[]
  commission        CommissionTransaction?

  @@map("applications")
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  status        ApplicationStatus
  changedById   String?           @map("changed_by_id")
  reason        String?
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")

  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

// ─── AGENCIES ────────────────────────────────────────────────────────────────

model Agency {
  id          String   @id @default(cuid())
  adminId     String?  @unique @map("admin_id")
  name        String
  slug        String   @unique
  email       String   @unique
  phone       String?
  website     String?
  address     String?
  city        String?
  country     String?
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  admin       User?    @relation("AgencyAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  agencyUsers AgencyUser[]
  referrals   StudentReferral[]
  commissions CommissionTransaction[]
  payouts     CommissionPayout[]

  @@map("agencies")
}

model AgencyUser {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  agencyId  String   @map("agency_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("agency_users")
}

model StudentReferral {
  id          String   @id @default(cuid())
  agencyId    String   @map("agency_id")
  studentId   String   @unique @map("student_id")
  referredById String? @map("referred_by_id") // agency counselor
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_referrals")
}

// ─── COMMISSIONS ─────────────────────────────────────────────────────────────

model CommissionTransaction {
  id              String           @id @default(cuid())
  applicationId   String           @unique @map("application_id")
  agencyId        String?          @map("agency_id")
  collegeId       String           @map("college_id")
  type            CommissionType   @default(PERCENTAGE)
  tuitionAmount   Decimal          @db.Decimal(12, 2) @map("tuition_amount")
  commissionRate  Decimal?         @db.Decimal(5, 2) @map("commission_rate") // % or fixed
  commissionAmount Decimal         @db.Decimal(12, 2) @map("commission_amount")
  status          CommissionStatus @default(PENDING)
  approvedById    String?          @map("approved_by_id")
  approvedAt      DateTime?        @map("approved_at")
  notes           String?
  payoutId        String?          @map("payout_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agency          Agency?          @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  college         College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  payout          CommissionPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@map("commission_transactions")
}

model CommissionPayout {
  id            String                  @id @default(cuid())
  agencyId      String                  @map("agency_id")
  totalAmount   Decimal                 @db.Decimal(12, 2) @map("total_amount")
  paymentMethod String?                 @map("payment_method")
  referenceNo   String?                 @map("reference_no")
  paidAt        DateTime?               @map("paid_at")
  notes         String?
  createdAt     DateTime                @default(now()) @map("created_at")

  // Relations
  agency        Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  transactions  CommissionTransaction[]

  @@map("commission_payouts")
}

// ─── PAYMENTS (FUTURE READY) ──────────────────────────────────────────────────

model Plan {
  id            String         @id @default(cuid())
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  interval      String         @default("month") // month | year
  features      Json
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id            String    @id @default(cuid())
  planId        String    @map("plan_id")
  entityType    String    @map("entity_type") // "college" | "agency"
  entityId      String    @map("entity_id")
  status        String    @default("active") // active | cancelled | expired
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  cancelledAt   DateTime? @map("cancelled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  plan          Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String?      @map("subscription_id")
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  amount         Decimal      @db.Decimal(10, 2)
  currency       String       @default("INR")
  status         String       @default("pending") // pending | completed | failed | refunded
  provider       String?      // stripe | razorpay
  providerTxnId  String?      @unique @map("provider_txn_id")
  metadata       Json?
  paidAt         DateTime?    @map("paid_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("payments")
}
