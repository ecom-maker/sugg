// Sugg Admission Management Platform - Prisma Schema
// PostgreSQL (Supabase) + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SUGG_COUNSELOR
  SUGG_BRANCH_MANAGER
  COLLEGE_ADMIN
  AGENCY_OWNER
  AGENCY_ADMIN
  BRANCH_MANAGER
  AGENCY_COUNSELOR
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AssignmentStrategy {
  ROUND_ROBIN
  MANUAL
  COURSE_BASED
  BRANCH_BASED
}

// Sugg Branch operational status. Reuses the ACTIVE/INACTIVE/ARCHIVED shape of
// BranchStatus but is a distinct type so Sugg Branches are never conflated with
// agency_branches at the schema level.
enum SuggBranchStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Agency lifecycle within the Sugg Branch onboarding workflow. Defaults to
// APPROVED so all pre-existing agencies remain fully active after migration.
enum AgencyApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

// How an agency entered the platform.
enum OnboardingSource {
  SELF_REGISTERED
  ADMIN_CREATED
}

// Lifecycle of an agency staff member (invite → active).
enum AgencyUserStatus {
  PENDING
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Agency areas of focus (stored as an array on agencies).
enum AgencySpecialization {
  DOMESTIC_ADMISSIONS
  STUDY_ABROAD
  MEDICAL
  ENGINEERING
  MANAGEMENT
  OTHER
}

enum CollegeStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum UniversityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UniversityType {
  PUBLIC
  PRIVATE
  DEEMED
  AUTONOMOUS
  INTERNATIONAL
}

enum GeoStatus {
  ACTIVE
  INACTIVE
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TeamMemberStatus {
  ACTIVE
  REMOVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  COUNSELING_SCHEDULED
  COLLEGE_SHORTLISTED
  APPLICATION_SUBMITTED
  OFFER_RECEIVED
  ADMISSION_CONFIRMED
  LOST
}

enum LeadSource {
  WHATSAPP
  AGENCY_REFERRAL
  MANUAL_ENTRY
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  ENROLLED
}

enum CommissionType {
  FIXED
  PERCENTAGE
  SLAB
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
}

enum NotificationType {
  NEW_LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
  FOLLOW_UP_REMINDER
  NEW_APPLICATION
  APPLICATION_STATUS_CHANGED
  COMMISSION_APPROVED
  COMMISSION_PAID
  COLLEGE_APPROVED
  COLLEGE_REJECTED
  NEW_COLLEGE_REGISTRATION
  NEW_REFERRAL
  DOCUMENT_EXPIRING
  POSSIBLE_DUPLICATE
  STUDENT_ANONYMIZED
  NEW_AGENCY_IN_TERRITORY
  AGENCY_ASSIGNED_SUGG_BRANCH
  AGENCY_RECOMMENDATION_SUBMITTED
  AGENCY_SUSPENSION_RECOMMENDED
  UNASSIGNED_TERRITORY_AGENCY
  TERRITORY_REPORT_READY
  NEW_AGENCY_REGISTRATION
  AGENCY_APPROVED
  AGENCY_REJECTED
  AGENCY_SUSPENDED
  COUNSELOR_ACTIVATED
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CallType {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  ANSWERED
  MISSED
  VOICEMAIL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum DegreeType {
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
  CERTIFICATE
  OTHER
}

enum AssignmentRule {
  ROUND_ROBIN
  COURSE_BASED
  MANUAL
}

// ─── STUDENT PROFILE ENUMS ────────────────────────────────────────────────────

enum StudentDocumentType {
  TENTH_MARKSHEET
  TWELFTH_MARKSHEET
  BACHELOR_DEGREE
  BACHELOR_TRANSCRIPT
  MASTER_DEGREE
  PASSPORT
  NATIONAL_ID
  PHOTO
  IELTS_SCORE
  TOEFL_SCORE
  PTE_SCORE
  GRE_SCORE
  GMAT_SCORE
  SOP
  LOR
  RESUME
  WORK_EXPERIENCE_LETTER
  FINANCIAL_STATEMENT
  OTHER
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum StudentDocumentStatus {
  ACTIVE
  ARCHIVED
}

enum StudentEducationLevel {
  TENTH
  TWELFTH
  DIPLOMA
  BACHELOR
  MASTER
  DOCTORATE
  CERTIFICATION
}

enum GradingSystem {
  PERCENTAGE
  CGPA_10
  CGPA_4
  GPA
  GRADE
}

enum EducationRecordStatus {
  ACTIVE
  ARCHIVED
}

enum StudentTestType {
  IELTS
  TOEFL
  PTE
  GRE
  GMAT
  SAT
  DUOLINGO
  OTHER
}

enum ShortlistStatus {
  SHORTLISTED
  APPLIED
  OFFER_RECEIVED
  REJECTED
  WITHDRAWN
}

enum ConsentType {
  DATA_PROCESSING
  CONTACT_WHATSAPP
  CONTACT_CALL
  CONTACT_EMAIL
  SHARE_WITH_COLLEGES
  SHARE_WITH_AGENCIES
}

enum ConsentSource {
  WHATSAPP
  FORM
  VERBAL_RECORDED
  MANUAL
}

enum DuplicateFlagReason {
  EMAIL_MATCH
  MOBILE_COLLISION
  MANUAL
}

enum DuplicateFlagStatus {
  PENDING
  MERGED
  DISMISSED
}

// ─── GEOGRAPHIC HIERARCHY ─────────────────────────────────────────────────────

model Country {
  id          String    @id @default(cuid())
  countryName String    @unique @map("country_name")
  countryCode String    @unique @map("country_code")
  status      GeoStatus @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  states    State[]
  branches  AgencyBranch[]
  colleges  College[]
  students  Student[]
  educationHistory StudentEducationHistory[]
  agencies         Agency[]
  suggBranches     SuggBranch[]
  suggBranchTerritories SuggBranchTerritory[]

  @@map("countries")
}

model State {
  id        String    @id @default(cuid())
  countryId String    @map("country_id")
  stateName String    @map("state_name")
  stateCode String?   @map("state_code")
  status    GeoStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  districts District[]
  branches  AgencyBranch[]
  colleges  College[]
  students  Student[]
  agencies              Agency[]
  suggBranches          SuggBranch[]
  suggBranchTerritories SuggBranchTerritory[]

  @@unique([countryId, stateName])
  @@map("states")
}

model District {
  id           String    @id @default(cuid())
  stateId      String    @map("state_id")
  districtName String    @map("district_name")
  status       GeoStatus @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  state     State          @relation(fields: [stateId], references: [id], onDelete: Cascade)
  branches  AgencyBranch[]
  colleges  College[]
  students  Student[]
  teams     Team[]
  agencies              Agency[]
  suggBranches          SuggBranch[]
  suggBranchTerritories SuggBranchTerritory[]

  @@unique([stateId, districtName])
  @@map("districts")
}

// ─── TEAMS (GEOGRAPHY-BOUND) ─────────────────────────────────────────────────

model Team {
  id           String     @id @default(cuid())
  teamName     String     @map("team_name")
  districtId   String     @map("district_id")
  branchId     String     @map("branch_id")
  teamLeadId   String?    @map("team_lead_id")
  status       TeamStatus @default(ACTIVE)
  needsReview  Boolean    @default(false) @map("needs_review")
  createdById  String?    @map("created_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  district   District    @relation(fields: [districtId], references: [id], onDelete: Restrict)
  branch     AgencyBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  teamLead   AgencyUser?  @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation("TeamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members    TeamMember[]

  @@map("teams")
}

model TeamMember {
  id          String           @id @default(cuid())
  teamId      String           @map("team_id")
  counselorId String           @map("counselor_id")
  joinedAt    DateTime         @default(now()) @map("joined_at")
  status      TeamMemberStatus @default(ACTIVE)

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  counselor AgencyUser @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([teamId, counselorId])
  @@map("team_members")
}

// ─── IDENTITY & AUTH ─────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  supabaseId       String    @unique @map("supabase_id")
  email            String    @unique
  phone            String?   @unique
  fullName         String    @map("full_name")
  avatarUrl        String?   @map("avatar_url")
  role             UserRole
  capabilities     String[]  @default([])
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  college          College?      @relation("CollegeAdmin")
  collegeUser      CollegeUser?
  ownedAgency      Agency?       @relation("AgencyOwner")
  managedBranch    AgencyBranch? @relation("BranchManager")
  managedSuggBranch SuggBranch?  @relation("SuggBranchManager")
  agencyUser       AgencyUser?
  counselor        Counselor?

  assignedLeads    Lead[]    @relation("AssignedCounselor")
  leadNotes        LeadNote[]
  leadFollowups    LeadFollowup[]
  sentMessages     WhatsappMessage[] @relation("MessageSender")
  calls            Call[]
  tasks            Task[]    @relation("TaskCreator")
  assignedTasks    Task[]    @relation("TaskAssignee")
  notifications    Notification[]
  auditLogs        AuditLog[]
  counselorCommissions CommissionTransaction[] @relation("CounselorCommissions")
  createdUniversities University[] @relation("UniversityCreator")
  updatedUniversities University[] @relation("UniversityUpdater")
  createdTeams        Team[]       @relation("TeamCreator")
  createdSuggBranches SuggBranch[] @relation("SuggBranchCreator")
  updatedSuggBranches SuggBranch[] @relation("SuggBranchUpdater")
  recommendedAgencies Agency[]     @relation("AgencyRecommender")
  approvedAgencies    Agency[]     @relation("AgencyApprover")
  leadStatusChanges   LeadStatusHistory[] @relation("LeadStatusChanger")
  uploadedDocuments   StudentDocument[] @relation("DocumentUploader")
  verifiedDocuments   StudentDocument[] @relation("DocumentVerifier")
  shortlistsCreated   StudentShortlist[] @relation("ShortlistCreator")
  consentsCaptured    StudentConsent[] @relation("ConsentCapturedBy")
  duplicateReviews    StudentDuplicateFlag[] @relation("DuplicateReviewer")
  employee            Employee?    @relation("EmployeeUser")

  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  roleId      String   @map("role_id")
  resource    String   // e.g. "leads", "colleges", "commissions"
  action      String   // e.g. "create", "read", "update", "delete"
  createdAt   DateTime @default(now()) @map("created_at")

  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── STUDENTS & LEADS ────────────────────────────────────────────────────────

model Student {
  id                     String     @id @default(cuid())
  name                   String
  mobile                 String     @unique
  mobileNumberNormalized String?    @unique @map("mobile_number_normalized")
  email                  String?
  city                   String?
  country                String?
  educationLevel         String?    @map("education_level")
  qualification          String?
  interestedCourse       String?    @map("interested_course")
  preferredCollege       String?    @map("preferred_college")
  preferredCountry       String?    @map("preferred_country")
  shortlistedCollege     String?    @map("shortlisted_college")
  budget                 Decimal?   @db.Decimal(12, 2)
  budgetMin              Decimal?   @db.Decimal(12, 2) @map("budget_min")
  source                 LeadSource @default(WHATSAPP)
  whatsappId             String?    @unique @map("whatsapp_id")
  agencyId               String?    @map("agency_id")
  branchId               String?    @map("branch_id")
  countryId              String?    @map("country_id")
  stateId                String?    @map("state_id")
  districtId             String?    @map("district_id")
  isActive               Boolean    @default(true) @map("is_active")
  isAnonymized           Boolean    @default(false) @map("is_anonymized")
  mergedIntoId           String?    @map("merged_into_id")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  // Relations
  leads                  Lead[]
  applications           Application[]
  whatsappMessages       WhatsappMessage[]
  referral               StudentReferral?
  agency                 Agency?    @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  branch                 AgencyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  geoCountry             Country?   @relation(fields: [countryId], references: [id], onDelete: SetNull)
  geoState               State?     @relation(fields: [stateId], references: [id], onDelete: SetNull)
  geoDistrict            District?  @relation(fields: [districtId], references: [id], onDelete: SetNull)
  mergedInto             Student?   @relation("StudentMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom             Student[]  @relation("StudentMerge")
  documents              StudentDocument[]
  educationHistory       StudentEducationHistory[]
  testScores             StudentTestScore[]
  shortlists             StudentShortlist[]
  consents               StudentConsent[]
  duplicateFlagsA        StudentDuplicateFlag[] @relation("DuplicateStudentA")
  duplicateFlagsB        StudentDuplicateFlag[] @relation("DuplicateStudentB")
  calls                  Call[]

  @@map("students")
}

model Lead {
  id                String     @id @default(cuid())
  code              String?    @unique
  studentId         String     @map("student_id")
  source            LeadSource @default(WHATSAPP)
  status            LeadStatus @default(NEW)
  score             Int        @default(0)
  isCurrent         Boolean    @default(true) @map("is_current")
  assignedToId      String?    @map("assigned_to_id")
  branchId          String?    @map("branch_id")
  suggBranchId      String?    @map("sugg_branch_id")
  assignmentRule    AssignmentRule? @map("assignment_rule")
  lastContactedAt   DateTime?  @map("last_contacted_at")
  nextFollowUpAt    DateTime?  @map("next_follow_up_at")
  expectedClosingDate DateTime? @map("expected_closing_date")
  lostReason        String?    @map("lost_reason")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relations
  student           Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedTo        User?        @relation("AssignedCounselor", fields: [assignedToId], references: [id], onDelete: SetNull)
  branch            AgencyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  suggBranch        SuggBranch?  @relation("SuggBranchLeads", fields: [suggBranchId], references: [id], onDelete: SetNull)
  notes             LeadNote[]
  followups         LeadFollowup[]
  statusHistory     LeadStatusHistory[]

  @@index([studentId, isCurrent])
  @@map("leads")
}

// Append-only history of lead status transitions (mirrors
// application_status_history). History starts from deployment; no backfill.
model LeadStatusHistory {
  id          String     @id @default(cuid())
  leadId      String     @map("lead_id")
  fromStatus  LeadStatus? @map("from_status")
  toStatus    LeadStatus @map("to_status")
  changedById String?    @map("changed_by_id")
  note        String?
  createdAt   DateTime   @default(now()) @map("created_at")

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy   User? @relation("LeadStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("lead_status_history")
}

// ─── STUDENT PROFILE ──────────────────────────────────────────────────────────

model StudentDocument {
  id                 String                     @id @default(cuid())
  studentId          String                     @map("student_id")
  documentType       StudentDocumentType        @map("document_type")
  documentName       String                     @map("document_name")
  fileUrl            String                     @map("file_url")
  fileSize           Int                        @map("file_size")
  mimeType           String                     @map("mime_type")
  verificationStatus DocumentVerificationStatus @default(PENDING) @map("verification_status")
  verifiedById       String?                    @map("verified_by_id")
  verifiedAt         DateTime?                  @map("verified_at")
  expiryDate         DateTime?                  @map("expiry_date")
  uploadedById       String                     @map("uploaded_by_id")
  status             StudentDocumentStatus      @default(ACTIVE)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  student            Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedBy         User?                      @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  uploadedBy         User                       @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  testScores         StudentTestScore[]

  @@map("student_documents")
}

model StudentEducationHistory {
  id               String                @id @default(cuid())
  studentId        String                @map("student_id")
  educationLevel   StudentEducationLevel @map("education_level")
  institutionName  String                @map("institution_name")
  boardOrUniversity String?              @map("board_or_university")
  streamOrMajor    String?               @map("stream_or_major")
  yearOfCompletion Int?                  @map("year_of_completion")
  gradingSystem    GradingSystem         @map("grading_system")
  scoreValue       Decimal               @map("score_value") @db.Decimal(8, 2)
  scoreMax         Decimal?              @map("score_max") @db.Decimal(8, 2)
  countryId        String?               @map("country_id")
  migratedFromLegacy Boolean             @default(false) @map("migrated_from_legacy")
  status           EducationRecordStatus @default(ACTIVE)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  student          Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  country          Country?              @relation(fields: [countryId], references: [id], onDelete: SetNull)

  @@map("student_education_history")
}

model StudentTestScore {
  id             String          @id @default(cuid())
  studentId      String          @map("student_id")
  testType       StudentTestType @map("test_type")
  overallScore   Decimal         @map("overall_score") @db.Decimal(8, 2)
  sectionScores  Json?           @map("section_scores")
  testDate       DateTime?       @map("test_date")
  validUntil     DateTime?       @map("valid_until")
  documentId     String?         @map("document_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  document       StudentDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@map("student_test_scores")
}

model StudentShortlist {
  id             String          @id @default(cuid())
  studentId      String          @map("student_id")
  courseId       String          @map("course_id")
  collegeId      String          @map("college_id")
  priority       Int             @default(1)
  status         ShortlistStatus @default(SHORTLISTED)
  shortlistedById String         @map("shortlisted_by_id")
  applicationId  String?         @unique @map("application_id")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  college        College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  shortlistedBy  User            @relation("ShortlistCreator", fields: [shortlistedById], references: [id], onDelete: Cascade)
  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@map("student_shortlists")
}

model StudentConsent {
  id                 String        @id @default(cuid())
  studentId          String        @map("student_id")
  consentType        ConsentType   @map("consent_type")
  consentGiven       Boolean       @map("consent_given")
  consentSource      ConsentSource @map("consent_source")
  consentTextVersion String        @map("consent_text_version")
  capturedById       String?       @map("captured_by_id")
  capturedAt         DateTime      @default(now()) @map("captured_at")
  withdrawnAt        DateTime?     @map("withdrawn_at")

  student            Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  capturedBy         User?         @relation("ConsentCapturedBy", fields: [capturedById], references: [id], onDelete: SetNull)

  @@unique([studentId, consentType])
  @@map("student_consents")
}

model StudentDuplicateFlag {
  id           String              @id @default(cuid())
  studentAId   String              @map("student_a_id")
  studentBId   String              @map("student_b_id")
  reason       DuplicateFlagReason
  status       DuplicateFlagStatus @default(PENDING)
  reviewedById String?             @map("reviewed_by_id")
  reviewedAt   DateTime?           @map("reviewed_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  studentA     Student             @relation("DuplicateStudentA", fields: [studentAId], references: [id], onDelete: Cascade)
  studentB     Student             @relation("DuplicateStudentB", fields: [studentBId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("DuplicateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([studentAId, studentBId])
  @@map("student_duplicate_flags")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

model LeadFollowup {
  id          String     @id @default(cuid())
  leadId      String     @map("lead_id")
  userId      String     @map("user_id")
  title       String
  description String?
  dueAt       DateTime   @map("due_at")
  status      TaskStatus @default(PENDING)
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lead_followups")
}

// ─── COUNSELORS ──────────────────────────────────────────────────────────────

model Counselor {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  suggBranchId    String?  @map("sugg_branch_id")
  specializations String[] // course types they specialize in
  maxLeads        Int      @default(50) @map("max_leads")
  isAvailable     Boolean  @default(true) @map("is_available")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggBranch      SuggBranch? @relation(fields: [suggBranchId], references: [id], onDelete: SetNull)

  @@map("counselors")
}

// ─── COMMUNICATION ───────────────────────────────────────────────────────────

model WhatsappMessage {
  id             String           @id @default(cuid())
  studentId      String           @map("student_id")
  senderId       String?          @map("sender_id")
  direction      MessageDirection
  messageId      String?          @unique @map("message_id") // Meta message ID
  type           String           @default("text") // text, image, document, audio
  content        String?
  mediaUrl       String?          @map("media_url")
  mediaType      String?          @map("media_type")
  status         MessageStatus    @default(SENT)
  sentAt         DateTime?        @map("sent_at")
  deliveredAt    DateTime?        @map("delivered_at")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sender         User?            @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@map("whatsapp_messages")
}

model Call {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  studentId   String?    @map("student_id")
  type        CallType
  status      CallStatus
  phoneNumber String     @map("phone_number")
  duration    Int?       // seconds
  notes       String?
  recordingUrl String?   @map("recording_url")
  startedAt   DateTime?  @map("started_at")
  endedAt     DateTime?  @map("ended_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  student     Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@map("calls")
}

model Task {
  id          String     @id @default(cuid())
  creatorId   String     @map("creator_id")
  assigneeId  String?    @map("assignee_id")
  title       String
  description String?
  dueAt       DateTime?  @map("due_at")
  status      TaskStatus @default(PENDING)
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  resourceId String?          @map("resource_id")
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── COLLEGES ────────────────────────────────────────────────────────────────

model University {
  id                String          @id @default(cuid())
  name              String          @unique
  establishmentYear Int             @map("establishment_year")
  location          String
  city              String?
  state             String?
  country           String
  website           String?
  universityType    UniversityType? @map("university_type")
  accreditation     String?
  logoUrl           String?         @map("logo_url")
  description       String?
  status            UniversityStatus @default(ACTIVE)
  createdById       String?         @map("created_by")
  updatedById       String?         @map("updated_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  createdBy         User?           @relation("UniversityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?           @relation("UniversityUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  colleges          College[]

  @@map("universities")
}

model College {
  id                    String        @id @default(cuid())
  adminId               String?       @unique @map("admin_id")
  universityId          String?       @map("university_id")
  name                  String
  slug                  String        @unique
  website               String?
  officialEmail         String        @unique @map("official_email")
  contactPhone          String?       @map("contact_phone")
  contactPersonName     String?       @map("contact_person_name")
  contactPersonDesig    String?       @map("contact_person_desig")
  contactPersonPhone    String?       @map("contact_person_phone")
  address               String?
  city                  String?
  state                 String?
  country               String?
  pincode               String?
  logoUrl               String?       @map("logo_url")
  bannerUrl             String?       @map("banner_url")
  description           String?
  status                CollegeStatus @default(PENDING)
  isVerified            Boolean       @default(false) @map("is_verified")
  emailVerified         Boolean       @default(false) @map("email_verified")
  mobileVerified        Boolean       @default(false) @map("mobile_verified")
  termsAcceptedAt       DateTime?     @map("terms_accepted_at")
  termsAcceptedById     String?       @map("terms_accepted_by_id")
  verificationToken     String?       @map("verification_token")
  verificationExpiry    DateTime?     @map("verification_expiry")
  establishedYear       Int?          @map("established_year")
  accreditation         String[]
  approvedAt            DateTime?     @map("approved_at")
  approvedById          String?       @map("approved_by_id")
  rejectionReason       String?       @map("rejection_reason")
  socialLinks           Json?         @map("social_links_json")
  countryId             String?       @map("country_id")
  stateId               String?       @map("state_id")
  districtId            String?       @map("district_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  // Relations
  admin            User?              @relation("CollegeAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  university       University?        @relation(fields: [universityId], references: [id], onDelete: SetNull)
  geoCountry       Country?           @relation(fields: [countryId], references: [id], onDelete: SetNull)
  geoState         State?             @relation(fields: [stateId], references: [id], onDelete: SetNull)
  geoDistrict      District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  collegeUsers     CollegeUser[]
  courses          Course[]
  applications     Application[]
  galleries        Gallery[]
  documents        Document[]
  socialLinksRel   SocialLink[]
  googleReviews    GoogleReview[]
  scholarships     Scholarship[]
  hostels          Hostel[]
  commissions      CommissionTransaction[]
  shortlists       StudentShortlist[]

  @@map("colleges")
}

model CollegeUser {
  id          String   @id @default(cuid())
  collegeId   String   @map("college_id")
  userId      String   @unique @map("user_id")
  designation String?
  permissions Json?
  createdAt   DateTime @default(now()) @map("created_at")

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("college_users")
}

model Course {
  id                  String          @id @default(cuid())
  collegeId           String          @map("college_id")
  name                String
  degreeType          DegreeType
  duration            String
  durationMonths      Int?            @map("duration_months")
  eligibility         String?
  totalSeats          Int?            @map("total_seats")
  availableSeats      Int?            @map("available_seats")
  annualFee           Decimal?        @db.Decimal(12, 2) @map("annual_fee")
  semesterFee         Decimal?        @db.Decimal(12, 2) @map("semester_fee")
  totalFee            Decimal?        @db.Decimal(12, 2) @map("total_fee")
  description         String?
  syllabus            String?
  // ── Agency Commission Configuration ──
  commissionType      CommissionType? @map("commission_type")
  commissionValue     Decimal?        @db.Decimal(10, 4) @map("commission_value")
  commissionCurrency  String          @default("INR") @map("commission_currency")
  commissionRules     Json?           @map("commission_rules")
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  // Relations
  college         College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  applications    Application[]
  scholarships    Scholarship[]
  shortlists      StudentShortlist[]

  @@map("courses")
}

// Master catalog of standard courses offered in India. This is reference data
// (not tied to a college) used to populate the college "Add Course" picker.
// Colleges may still add courses manually when a course isn't in the catalog.
model CourseCatalog {
  id         String     @id @default(cuid())
  name       String
  degreeType DegreeType
  field      String?    // e.g. Engineering, Medical, Commerce, Arts, Science, Management, Law
  duration   String?    // typical duration, e.g. "4 years"
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@unique([name, degreeType])
  @@index([name])
  @@map("course_catalog")
}

model Gallery {
  id          String   @id @default(cuid())
  collegeId   String   @map("college_id")
  url         String
  caption     String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("galleries")
}

model Document {
  id          String   @id @default(cuid())
  collegeId   String   @map("college_id")
  name        String
  url         String
  type        String   // "brochure", "accreditation", "affiliation", etc.
  createdAt   DateTime @default(now()) @map("created_at")

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model SocialLink {
  id         String   @id @default(cuid())
  collegeId  String   @map("college_id")
  platform   String   // "facebook", "instagram", "linkedin", "twitter", "youtube"
  url        String
  createdAt  DateTime @default(now()) @map("created_at")

  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("social_links")
}

model GoogleReview {
  id          String   @id @default(cuid())
  collegeId   String   @map("college_id")
  reviewerName String  @map("reviewer_name")
  rating      Int      // 1-5
  comment     String?
  reviewDate  DateTime @map("review_date")
  sourceUrl   String?  @map("source_url")
  createdAt   DateTime @default(now()) @map("created_at")

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("google_reviews")
}

model Scholarship {
  id          String   @id @default(cuid())
  collegeId   String   @map("college_id")
  courseId    String?  @map("course_id")
  name        String
  description String?
  amount      Decimal? @db.Decimal(12, 2)
  percentage  Decimal? @db.Decimal(5, 2)
  eligibility String?
  deadline    DateTime?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("scholarships")
}

model Hostel {
  id            String   @id @default(cuid())
  collegeId     String   @map("college_id")
  type          String   // "boys", "girls", "co-ed"
  totalRooms    Int?     @map("total_rooms")
  monthlyRent   Decimal? @db.Decimal(10, 2) @map("monthly_rent")
  annualRent    Decimal? @db.Decimal(10, 2) @map("annual_rent")
  amenities     String[]
  description   String?
  isAvailable   Boolean  @default(true) @map("is_available")
  createdAt     DateTime @default(now()) @map("created_at")

  college       College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("hostels")
}

// ─── APPLICATIONS ────────────────────────────────────────────────────────────

model Application {
  id                String            @id @default(cuid())
  studentId         String            @map("student_id")
  collegeId         String            @map("college_id")
  courseId          String            @map("course_id")
  branchId          String?           @map("branch_id")
  status            ApplicationStatus @default(SUBMITTED)
  submittedById     String?           @map("submitted_by_id")
  managedBy         String            @default("SUGG") @map("managed_by")
  applicationFee    Decimal?          @db.Decimal(10, 2) @map("application_fee")
  documents         Json?
  notes             String?
  acceptanceDeadline DateTime?        @map("acceptance_deadline")
  enrolledAt        DateTime?         @map("enrolled_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  college           College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  branch            AgencyBranch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  statusHistory     ApplicationStatusHistory[]
  commission        CommissionTransaction?
  shortlist         StudentShortlist?

  @@map("applications")
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  status        ApplicationStatus
  changedById   String?           @map("changed_by_id")
  reason        String?
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")

  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

// ─── AGENCIES ────────────────────────────────────────────────────────────────

model Agency {
  id                 String   @id @default(cuid())
  ownerId            String?  @unique @map("owner_id")
  name               String
  slug               String   @unique
  registrationNumber String?  @map("registration_number")
  email              String   @unique
  phone              String?
  website            String?
  // Agency owner / point-of-contact identity (captured at onboarding).
  ownerName          String?  @map("owner_name")
  ownerMobile        String?  @map("owner_mobile")
  ownerEmail         String?  @map("owner_email")
  nationalIdType     String?  @map("national_id_type")
  nationalIdNumber   String?  @map("national_id_number")
  // Optional manager captured at registration (an Agency Admin is pre-created).
  managerName        String?  @map("manager_name")
  managerPhone       String?  @map("manager_phone")
  managerEmail       String?  @map("manager_email")
  yearEstablished    Int?     @map("year_established")
  counselorCountEstimate Int? @map("counselor_count_estimate")
  specialization     AgencySpecialization[]
  headquarters       String?
  address            String?
  city               String?
  state              String?
  country            String?
  logoUrl            String?  @map("logo_url")
  isActive           Boolean  @default(true) @map("is_active")
  isVerified         Boolean  @default(false) @map("is_verified")
  assignmentStrategy AssignmentStrategy @default(ROUND_ROBIN) @map("assignment_strategy")

  // Sugg Branch Network layer (nullable — agencies stay unassigned until a
  // covering Sugg Branch + territory exists). suggBranchId is the covering
  // regional office; geo FKs drive territory resolution.
  suggBranchId       String?  @map("sugg_branch_id")
  countryId          String?  @map("country_id")
  stateId            String?  @map("state_id")
  districtId         String?  @map("district_id")

  // Onboarding recommendation workflow. Defaults to APPROVED so existing
  // agencies are unaffected; new agencies enter PENDING and a Sugg Branch
  // Manager recommends before a Super Admin makes the final decision.
  approvalStatus     AgencyApprovalStatus @default(APPROVED) @map("approval_status")
  recommendationNote String?  @map("recommendation_note")
  recommendedById    String?  @map("recommended_by_id")
  recommendedAt      DateTime? @map("recommended_at")

  // Onboarding lifecycle (mirrors the college flow). isVerified = combined
  // VERIFIED state once email + mobile OTP succeed.
  onboardingSource   OnboardingSource @default(ADMIN_CREATED) @map("onboarding_source")
  verificationToken  String?  @map("verification_token")
  verificationExpiry DateTime? @map("verification_expiry")
  emailVerified      Boolean  @default(false) @map("email_verified")
  mobileVerified     Boolean  @default(false) @map("mobile_verified")
  termsAcceptedAt    DateTime? @map("terms_accepted_at")
  termsAcceptedById  String?  @map("terms_accepted_by_id")
  approvedById       String?  @map("approved_by_id")
  approvedAt         DateTime? @map("approved_at")
  rejectionReason    String?  @map("rejection_reason")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  owner       User?         @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedBy  User?         @relation("AgencyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  suggBranch  SuggBranch?   @relation(fields: [suggBranchId], references: [id], onDelete: SetNull)
  geoCountry  Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  geoState    State?        @relation(fields: [stateId], references: [id], onDelete: SetNull)
  geoDistrict District?     @relation(fields: [districtId], references: [id], onDelete: SetNull)
  recommendedBy User?       @relation("AgencyRecommender", fields: [recommendedById], references: [id], onDelete: SetNull)
  branches    AgencyBranch[]
  agencyUsers AgencyUser[]
  referrals   StudentReferral[]
  commissions CommissionTransaction[]
  payouts     CommissionPayout[]
  students    Student[]

  @@map("agencies")
}

// ─── SUGG BRANCH NETWORK ─────────────────────────────────────────────────────
// Sugg-operated regional offices that sit ABOVE partner agencies. These are a
// distinct entity from agency_branches and must never be conflated with them.

model SuggBranch {
  id          String           @id @default(cuid())
  branchName  String           @unique @map("branch_name")
  branchCode  String           @unique @map("branch_code")
  address     String?
  countryId   String           @map("country_id")
  stateId     String?          @map("state_id")
  districtId  String?          @map("district_id")
  phone       String?
  email       String?
  managerId   String?          @unique @map("manager_id")
  status      SuggBranchStatus @default(ACTIVE)
  createdById String?          @map("created_by")
  updatedById String?          @map("updated_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  manager     User?     @relation("SuggBranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("SuggBranchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("SuggBranchUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  geoCountry  Country   @relation(fields: [countryId], references: [id], onDelete: Restrict)
  geoState    State?    @relation(fields: [stateId], references: [id], onDelete: SetNull)
  geoDistrict District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  territories SuggBranchTerritory[]
  agencies    Agency[]
  counselors  Counselor[]
  employees   Employee[] @relation("SuggBranchEmployees")
  leads       Lead[]     @relation("SuggBranchLeads")

  @@map("sugg_branches")
}

// Geographic coverage for a Sugg Branch. A null stateId means the whole
// country; a null districtId means the whole state. Overlap is enforced in
// application code (see src/lib/sugg-territory.ts) — most-specific match wins
// at resolution time (district → state → country).
model SuggBranchTerritory {
  id           String   @id @default(cuid())
  suggBranchId String   @map("sugg_branch_id")
  countryId    String   @map("country_id")
  stateId      String?  @map("state_id")
  districtId   String?  @map("district_id")
  createdAt    DateTime @default(now()) @map("created_at")

  suggBranch  SuggBranch @relation(fields: [suggBranchId], references: [id], onDelete: Cascade)
  geoCountry  Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  geoState    State?     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  geoDistrict District?  @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@index([countryId, stateId, districtId])
  @@map("sugg_branch_territories")
}

// Simple key/value store for platform-wide toggles (e.g. the territory-aware
// lead-assignment flag, which ships OFF by default).
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model AgencyBranch {
  id          String       @id @default(cuid())
  agencyId    String       @map("agency_id")
  branchName  String       @map("branch_name")
  branchCode  String       @unique @map("branch_code")
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?      @map("postal_code")
  countryId   String?      @map("country_id")
  stateId     String?      @map("state_id")
  districtId  String?      @map("district_id")
  phone       String?
  email       String?
  managerId   String?      @unique @map("manager_id")
  status      BranchStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  manager     User?        @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  agencyUsers AgencyUser[]
  students    Student[]
  leads       Lead[]
  applications Application[]
  commissions CommissionTransaction[]
  payouts     CommissionPayout[]
  targets     BranchTarget[]
  reports     BranchReport[]
  teams       Team[]
  geoCountry  Country?     @relation(fields: [countryId], references: [id], onDelete: SetNull)
  geoState    State?       @relation(fields: [stateId], references: [id], onDelete: SetNull)
  geoDistrict District?    @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@map("agency_branches")
}

model BranchTarget {
  id              String   @id @default(cuid())
  branchId        String   @map("branch_id")
  month           Int      // 1-12
  year            Int
  leadTarget      Int      @default(0) @map("lead_target")
  admissionTarget Int      @default(0) @map("admission_target")
  revenueTarget   Decimal  @default(0) @db.Decimal(12, 2) @map("revenue_target")
  createdAt       DateTime @default(now()) @map("created_at")

  branch          AgencyBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, month, year])
  @@map("branch_targets")
}

model BranchReport {
  id          String   @id @default(cuid())
  branchId    String   @map("branch_id")
  reportDate  DateTime @map("report_date")
  admissions  Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  commissions Decimal  @default(0) @db.Decimal(12, 2)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  branch      AgencyBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_reports")
}

model AgencyUser {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  agencyId  String   @map("agency_id")
  branchId  String?  @map("branch_id")
  status    AgencyUserStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency    Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branch    AgencyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  ledTeams  Team[]       @relation("TeamLead")
  teamMemberships TeamMember[]

  @@map("agency_users")
}

model StudentReferral {
  id           String   @id @default(cuid())
  agencyId     String   @map("agency_id")
  studentId    String   @unique @map("student_id")
  referredById String?  @map("referred_by_id")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_referrals")
}

// ─── COMMISSIONS ─────────────────────────────────────────────────────────────

model CommissionTransaction {
  id              String           @id @default(cuid())
  applicationId   String           @unique @map("application_id")
  agencyId        String?          @map("agency_id")
  branchId        String?          @map("branch_id")
  collegeId       String           @map("college_id")
  counselorId     String?          @map("counselor_id")
  type            CommissionType   @default(PERCENTAGE)
  tuitionAmount   Decimal          @db.Decimal(12, 2) @map("tuition_amount")
  commissionRate  Decimal?         @db.Decimal(5, 2) @map("commission_rate")
  commissionAmount Decimal         @db.Decimal(12, 2) @map("commission_amount")
  status          CommissionStatus @default(PENDING)
  approvedById    String?          @map("approved_by_id")
  approvedAt      DateTime?        @map("approved_at")
  notes           String?
  payoutId        String?          @map("payout_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  agency          Agency?          @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  branch          AgencyBranch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  college         College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  counselor       User?            @relation("CounselorCommissions", fields: [counselorId], references: [id], onDelete: SetNull)
  payout          CommissionPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@map("commission_transactions")
}

model CommissionPayout {
  id            String                  @id @default(cuid())
  agencyId      String                  @map("agency_id")
  branchId      String?                 @map("branch_id")
  totalAmount   Decimal                 @db.Decimal(12, 2) @map("total_amount")
  paymentMethod String?                 @map("payment_method")
  referenceNo   String?                 @map("reference_no")
  paidAt        DateTime?               @map("paid_at")
  notes         String?
  createdAt     DateTime                @default(now()) @map("created_at")

  // Relations
  agency        Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  branch        AgencyBranch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  transactions  CommissionTransaction[]

  @@map("commission_payouts")
}

// ─── PAYMENTS (FUTURE READY) ──────────────────────────────────────────────────

model Plan {
  id            String         @id @default(cuid())
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  interval      String         @default("month") // month | year
  features      Json
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id            String    @id @default(cuid())
  planId        String    @map("plan_id")
  entityType    String    @map("entity_type") // "college" | "agency"
  entityId      String    @map("entity_id")
  status        String    @default("active") // active | cancelled | expired
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  cancelledAt   DateTime? @map("cancelled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  plan          Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String?      @map("subscription_id")
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  amount         Decimal      @db.Decimal(10, 2)
  currency       String       @default("INR")
  status         String       @default("pending") // pending | completed | failed | refunded
  provider       String?      // stripe | razorpay
  providerTxnId  String?      @unique @map("provider_txn_id")
  metadata       Json?
  paidAt         DateTime?    @map("paid_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("payments")
}

// ─── HR ──────────────────────────────────────────────────────────────────────

enum EmployeeType {
  SUPER_ADMIN
  BRANCH_MANAGER
  ASST_BRANCH_MANAGER
  TEAM_LEADER
  COUNSELLOR
  OFFICE_ASSISTANT
  DRIVER
}

enum EmployeeIdType {
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  PAN
  VOTERS_ID
}

model Employee {
  id                String          @id @default(cuid())
  employeeCode      String          @unique @map("employee_code")
  firstName         String          @map("first_name")
  lastName          String          @map("last_name")
  dob               DateTime?       @db.Date
  address           String?
  personalPhone     String?         @map("personal_phone")
  officialPhone     String?         @map("official_phone")
  personalEmail     String?         @map("personal_email")
  officialEmail     String?         @map("official_email")
  emergencyName     String?         @map("emergency_name")
  emergencyRelation String?         @map("emergency_relation")
  emergencyPhone    String?         @map("emergency_phone")
  nationalIdType    EmployeeIdType? @map("national_id_type")
  nationalIdNumber  String?         @map("national_id_number")
  employeeType      EmployeeType    @map("employee_type")
  isActive          Boolean         @default(true) @map("is_active")
  userId            String?         @unique @map("user_id")
  branchId          String?         @map("branch_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user              User?           @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  branch            SuggBranch?     @relation("SuggBranchEmployees", fields: [branchId], references: [id], onDelete: SetNull)

  @@index([employeeType])
  @@index([lastName])
  @@index([branchId])
  @@map("employees")
}
